// =====================================================================
// RedSalud Te Forma — Campus Virtual · Esquema de base de datos (Prisma)
// Stack: Next.js 16 + Prisma + PostgreSQL
// MVP: roles como enum · 3 tipos de pregunta · plantilla de certificado
// simple (builder visual post-MVP)
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------
// Usuarios y roles
// ------------------------------------------------------------------

enum Role {
  ADMIN
  TUTOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum DocumentType {
  CC // Cédula de ciudadanía
  CE // Cédula de extranjería
  TI // Tarjeta de identidad
  PA // Pasaporte
}

// Clasificación laboral (distinta del Role de permisos): qué personal de la
// EPS/E.S.E. es cada usuario, para filtrar qué cursos le corresponden.
enum PersonnelType {
  ADMINISTRATIVO
  ASISTENCIAL
}

// Secciones del panel admin que se pueden restringir a un ADMIN puntual (para
// tener "niveles" de administrador: el admin principal no restringe ninguna,
// un admin junior puede tener varias en su lista de restringidas). Dashboard
// no aplica: siempre es accesible para cualquier ADMIN.
enum AdminSection {
  USUARIOS
  CURSOS
  PLANES_CAPACITACION
  INSCRIPCIONES
  CERTIFICADOS
  NOTIFICACIONES
  REPORTES
  CONFIGURACION
}

// Modalidad de nombramiento, tomada de la columna TIPO NOM del plan de cargos
// (la leyenda del propio archivo define los códigos). Todo el que está en el
// plan de cargos ES personal de planta: la estrella de la Fase 7.5 se muestra
// a cualquiera cuyo tipo NO sea CONTRATO_PRESTACION (los contratistas).
enum TipoVinculacion {
  CARRERA_ADMINISTRATIVA // KA
  PROVISIONALIDAD // PRO
  TEMPORAL // TEM
  TRABAJADOR_OFICIAL // T.O
  LIBRE_NOMBRAMIENTO // LNR
  PERIODO_FIJO // P.F
  CONTRATO_PRESTACION // contratistas: no son de planta, no llevan estrella
  OTRO
}

// Cómo entró la persona a la plataforma: el personal de planta lo provisiona
// Talento Humano por importación, no se auto-registra.
enum OrigenRegistro {
  IMPORTACION
  AUTO
}

// Municipio de procedencia. Tabla y no enum: Talento Humano necesita listar,
// filtrar y medir por municipio, y poder agregar municipios sin migración.
model Municipio {
  id           String  @id @default(cuid())
  nombre       String  @unique
  departamento String  @default("Casanare")
  isActive     Boolean @default(true)

  usuarios         User[]
  trainingSessions TrainingSession[]
}

// Cargo / tipo de profesional. Tabla y no enum: serán muchísimos y de esto
// dependen el filtro del catálogo y las métricas cruzadas del centro de datos.
model Cargo {
  id       String        @id @default(cuid())
  nombre   String        @unique
  // Grupo poblacional al que pertenece el cargo: permite derivar el grupo de
  // una persona cuando la fila importada no lo traiga explícito.
  personnelType PersonnelType
  isActive Boolean       @default(true)

  usuarios User[]

  @@index([personnelType])
}

model User {
  id             String       @id @default(cuid())
  fullName       String
  documentType   DocumentType
  documentNumber String       @unique
  email          String?      @unique // opcional: el personal sin correo entra con username
  // Identificador de acceso alterno (p. ej. "nombre.apellido"). Se usa cuando
  // la persona no tiene un correo válido propio: puede entrar con esto en vez
  // del correo. Nullable porque la mayoría entra con su correo institucional.
  username       String?      @unique
  phone          String?
  profession     String?
  position       String? // cargo como texto libre (heredado; ver cargoId)
  department     String? // dependencia o área
  // personnelType ES el grupo poblacional (ASISTENCIAL | ADMINISTRATIVO). No
  // se duplica en un campo nuevo: ya determina qué cursos ve cada persona a
  // través de Course.targetAudience.
  personnelType  PersonnelType @default(ADMINISTRATIVO)

  municipioId String?
  municipio   Municipio? @relation(fields: [municipioId], references: [id])
  cargoId     String?
  cargo       Cargo?     @relation(fields: [cargoId], references: [id])

  tipoVinculacion TipoVinculacion @default(CONTRATO_PRESTACION)
  origenRegistro  OrigenRegistro  @default(AUTO)
  provisionedAt   DateTime?
  provisionedBy   String?
  passwordHash   String
  role           Role         @default(STUDENT)
  status         UserStatus   @default(ACTIVE)
  mustChangePassword Boolean  @default(true) // admin crea con contraseña temporal
  // Solo aplica si role = ADMIN: secciones del panel a las que este admin NO
  // tiene acceso (vacío = admin principal, con acceso total). Nunca restringe
  // Dashboard.
  restrictedAdminSections AdminSection[] @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  lastLoginAt    DateTime?

  coursesTutored Course[]       @relation("CourseTutor")
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  certificates   Certificate[]
  mediaUploads   Media[]
  auditLogs      AuditLog[]
  trainingPlansAsTutor TrainingPlan[] @relation("TrainingPlanTutor")
  trainingPlansClosed  TrainingPlan[] @relation("TrainingPlanClosedBy")
  trainingActivitiesResponsible TrainingActivity[] @relation("TrainingActivityResponsible")
  trainingAreasLed              TrainingArea[]     @relation("TrainingAreaTutor")
  trainingAttendances TrainingAttendance[] @relation("TrainingAttendanceUser")
  trainingAttendancesRegistered TrainingAttendance[] @relation("TrainingAttendanceRegisteredBy")
  callConnections     CallConnectionLog[]
  asistenciasSesion   AsistenciaSesion[]  @relation("AsistenciaSesionUser")
  surveysCreated  Survey[]         @relation("SurveyCreatedBy")
  surveyResponses SurveyResponse[] @relation("SurveyRespondedBy")

  notificationsCreated  Notification[]     @relation("NotificationCreatedBy")
  notificationsTargeted Notification[]     @relation("NotificationTargetUser")
  notificationReads     NotificationRead[] @relation("NotificationReadBy")
  passwordResets        PasswordResetToken[]

  @@index([role, status])
  @@index([department])
  @@index([personnelType])
  // Dimensiones del centro de datos de Talento Humano (Fase 7.7): todas se
  // usan como filtro global y como eje de agregación.
  @@index([municipioId])
  @@index([cargoId])
  @@index([tipoVinculacion])
}

// ------------------------------------------------------------------
// Cursos y estructura
// ------------------------------------------------------------------

enum CourseType {
  INDUCCION
  REINDUCCION
  CAPACITACION
  OBLIGATORIO
  COMPLEMENTARIO
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentMode {
  ASSIGNED // solo asignación por admin
  OPEN     // el estudiante puede inscribirse
}

// A qué personal va dirigido el curso; filtra lo que cada estudiante ve en su catálogo.
enum CourseAudience {
  ADMINISTRATIVO
  ASISTENCIAL
  AMBOS
}

model CourseCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  courses Course[]
}

model Course {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  shortDescription String
  fullDescription  String?
  instructions     String? // indicaciones para el estudiante (HTML enriquecido, mismo tratamiento que Lesson.contentBody)
  imageUrl         String?
  categoryId       String?
  category         CourseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  courseType       CourseType
  durationHours    Int // intensidad horaria (aparece en el certificado)
  status           CourseStatus   @default(DRAFT)
  tutorId          String
  tutor            User           @relation("CourseTutor", fields: [tutorId], references: [id])
  passingScore     Int            @default(80) // % mínimo global del curso
  enrollmentMode   EnrollmentMode @default(ASSIGNED)
  targetAudience   CourseAudience @default(AMBOS)
  isSequential     Boolean        @default(false) // si se activa, el contenido se desbloquea en orden
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  publishedAt      DateTime?

  modules      CourseModule[]
  quizzes      Quiz[]
  enrollments  Enrollment[]
  certificates Certificate[]
  trainingActivities TrainingActivity[]

  @@index([status, courseType])
  @@index([status, targetAudience])
  // Todo el panel del tutor filtra sus cursos por tutorId.
  @@index([tutorId])
}

model CourseModule {
  id          String  @id @default(cuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  sortOrder   Int
  isRequired  Boolean @default(true)
  isActive    Boolean @default(true)

  lessons Lesson[]
  quizzes Quiz[]

  @@unique([courseId, sortOrder])
}

enum LessonContentType {
  TEXT
  YOUTUBE
  VIDEO // archivo de video subido al storage privado del proyecto (no YouTube)
  PDF
  IMAGE
  LINK
  MIXED
}

model Lesson {
  id               String            @id @default(cuid())
  moduleId         String
  module           CourseModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  contentType      LessonContentType
  contentBody      String? // texto enriquecido (HTML sanitizado)
  videoUrl         String? // URL de YouTube
  fileUrl          String? // PDF / imagen / descargable
  externalUrl      String?
  sortOrder        Int
  isRequired       Boolean           @default(true)
  estimatedMinutes Int?
  isActive         Boolean           @default(true)

  progress LessonProgress[]

  @@unique([moduleId, sortOrder])
}

// ------------------------------------------------------------------
// Cuestionarios (MVP: selección única, múltiple, verdadero/falso)
// ------------------------------------------------------------------

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  OPEN_TEXT // respuesta abierta: se guarda para revisión, no suma al puntaje automático
}

model Quiz {
  id                 String        @id @default(cuid())
  courseId           String
  course             Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId           String? // null = evaluación final del curso
  module             CourseModule? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  passingScore       Int           @default(80) // % mínimo de este quiz
  maxAttempts        Int           @default(10)
  timeLimitMinutes   Int?
  randomizeQuestions Boolean       @default(false)
  randomizeAnswers   Boolean       @default(false)
  showResultsNow     Boolean       @default(true)
  isActive           Boolean       @default(true)
  /**
   * Posición de la evaluación DENTRO de su módulo, en la misma escala que
   * Lesson.sortOrder: así un módulo puede llevar varias parejas
   * "presentación → evaluación" intercaladas (un área entrega varios temas
   * y cada tema tiene su propia evaluación seguida). Sin esto un módulo
   * solo podía mostrar una evaluación, siempre al final.
   */
  sortOrder          Int           @default(0)

  questions Question[]
  attempts  QuizAttempt[]

  @@index([courseId])
}

model Question {
  id          String       @id @default(cuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type        QuestionType
  statement   String
  // Área temática ("SST", "Talento Humano"). No se deriva del módulo porque
  // la evaluación final del curso tiene moduleId nulo y mezcla áreas.
  area        String?
  imageUrl    String? // imagen de apoyo del enunciado (p. ej. posturas a evaluar)
  expectedAnswer String? // respuesta modelo de las preguntas abiertas: se muestra en la revisión, nunca antes
  score       Int          @default(1)
  explanation String? // retroalimentación posterior
  sortOrder   Int
  isActive    Boolean      @default(true)

  options QuestionOption[]
  answers QuizAnswer[]

  @@unique([quizId, sortOrder])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false) // NUNCA exponer al cliente antes de calificar
  sortOrder  Int

  @@unique([questionId, sortOrder])
}

// ------------------------------------------------------------------
// Inscripción y progreso
// ------------------------------------------------------------------

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

model Enrollment {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status             EnrollmentStatus @default(ACTIVE)
  enrolledAt         DateTime         @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  deadlineAt         DateTime? // fecha límite si aplica
  progressPercentage Int              @default(0)
  finalScore         Int? // promedio de quizzes al completar

  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  certificate    Certificate?

  @@unique([userId, courseId])
  @@index([courseId, status])
}

enum ProgressStatus {
  PENDING
  COMPLETED
}

model LessonProgress {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status       ProgressStatus @default(PENDING)
  completedAt  DateTime?
  // Punto donde quedó en un video o PDF. Permite reanudar donde se dejó y
  // marcar completado al ~90 % sin depender de que el cliente lo recuerde.
  lastPositionSeconds Int?

  @@unique([userId, lessonId])
  @@index([enrollmentId])
}

model QuizAttempt {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId        String
  quiz          Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  enrollmentId  String
  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  attemptNumber Int
  score         Int? // % obtenido (null mientras está en curso)
  passed        Boolean?
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?

  /**
   * Cuándo se presentó este intento, para las evaluaciones que son "la
   * misma evaluación, dos veces": antes de la capacitación (PRESABER) y
   * después (POSTSABER). Se fija al crear el intento, según qué ventana
   * esté abierta en ese momento en la actividad del plan -no se deriva
   * después por fecha, para que un cambio posterior en las ventanas no
   * reclasifique intentos ya presentados-.
   *
   * Null en el resto de evaluaciones de la plataforma: la enorme mayoría de
   * quizzes no son un ciclo presaber/postsaber, son la evaluación normal de
   * un curso, y ahí este campo no aplica ni se toca.
   */
  moment EvaluationMoment?

  answers QuizAnswer[]

  @@unique([userId, quizId, attemptNumber])
}

enum EvaluationMoment {
  PRESABER
  POSTSABER
}

model QuizAnswer {
  id                String      @id @default(cuid())
  attemptId         String
  attempt           QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIds String[] // ids de QuestionOption elegidos
  textAnswer        String? // respuesta libre (preguntas de tipo OPEN_TEXT)
  // Marcada por el estudiante para volver a ella antes de enviar. Vive en el
  // servidor, no en el navegador: si cambia de equipo a mitad del intento,
  // sus marcas siguen ahí.
  flagged           Boolean     @default(false)
  isCorrect         Boolean
  scoreObtained     Int

  @@unique([attemptId, questionId])
}

// ------------------------------------------------------------------
// Certificados
// ------------------------------------------------------------------

enum CertificateStatus {
  VALID
  REVOKED
}

model CertificateTemplate {
  id                 String   @id @default(cuid())
  name               String
  backgroundImageUrl String?
  layoutJson         Json? // reservado para el builder visual (post-MVP)
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  certificates Certificate[]
}

model Certificate {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id])
  courseId        String
  course          Course              @relation(fields: [courseId], references: [id])
  enrollmentId    String              @unique
  enrollment      Enrollment          @relation(fields: [enrollmentId], references: [id])
  templateId      String?
  template        CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  certificateCode String              @unique // RSC-2026-XXXXXX
  validationHash  String              @unique // hash firmado para el QR
  pdfUrl          String?
  issuedAt        DateTime            @default(now())
  status          CertificateStatus   @default(VALID)
  revokedAt       DateTime?
  revokedReason   String?

  @@index([userId])
  // KPIs y listados de certificados por curso (panel del tutor y reportes).
  @@index([courseId])
  @@index([issuedAt])
}

// ------------------------------------------------------------------
// Configuración institucional, medios y auditoría
// ------------------------------------------------------------------

model InstitutionSettings {
  id              String  @id @default("singleton") // fila única
  institutionName String  @default("Red Salud Casanare E.S.E.")
  logoUrl         String?
  primaryColor    String  @default("#2BA6DE")
  navyColor       String  @default("#0F2438")
  contactEmail    String?
  contactPhone    String?
  certificateText String? // texto base del certificado
  signerName      String? // responsable certificador
  signerPosition  String? // cargo del responsable
  signatureUrl    String? // imagen de firma
  city            String  @default("Yopal, Casanare")
}

model Media {
  id         String   @id @default(cuid())
  fileName   String
  fileType   String // mime type
  fileUrl    String
  fileSize   Int // bytes
  folder     String? // organización simple por carpeta
  uploadedBy String
  uploader   User     @relation(fields: [uploadedBy], references: [id])
  createdAt  DateTime @default(now())

  // Documentos del plan de capacitaciones (Etapa 2): mismo modelo genérico
  // que ya usan lecciones y avatares, no un modelo de documento nuevo.
  trainingPlanId     String?
  trainingPlan       TrainingPlan?     @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  trainingActivityId String?
  trainingActivity   TrainingActivity? @relation(fields: [trainingActivityId], references: [id], onDelete: Cascade)

  @@index([folder])
  @@index([trainingPlanId])
  @@index([trainingActivityId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String // CREATE, UPDATE, DELETE, LOGIN, ISSUE_CERT, REVOKE_CERT...
  entity      String // Course, User, Certificate...
  entityId    String?
  description String?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ------------------------------------------------------------------
// Centro de notificaciones
// ------------------------------------------------------------------

enum NotificationTargetType {
  ALL // todos los usuarios
  ROLE // todos los usuarios de un rol
  USER // un único usuario
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  DANGER
}

model Notification {
  id           String                  @id @default(cuid())
  title        String
  body         String
  severity     NotificationSeverity    @default(INFO)
  targetType   NotificationTargetType
  targetRole   Role?
  targetUserId String?
  targetUser   User?                   @relation("NotificationTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User                    @relation("NotificationCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime                @default(now())

  reads NotificationRead[]

  @@index([targetType, targetRole])
  @@index([targetUserId])
  @@index([createdAt])
}

/** Estado de lectura por usuario; solo existe una fila una vez que el usuario la marca como leída. */
model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("NotificationReadBy", fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
}

// ------------------------------------------------------------------
// Plan de capacitaciones (Etapa 1: cronograma y plan)
// ------------------------------------------------------------------

enum TrainingPlanStatus {
  DRAFT
  ACTIVE
  // Cerrado con validaciones: la vigencia terminó, los indicadores son
  // definitivos y el plan queda de solo consulta. Distinto de ARCHIVED
  // (retirado de la vista) porque un plan cerrado sigue siendo el registro
  // oficial de lo que pasó y se sigue consultando y exportando.
  CLOSED
  ARCHIVED
}

/**
 * Gestionado por TUTOR (sus propios planes) y ADMIN (todos, sin límite,
 * incluyendo crear en nombre de un tutor). Una sola UI para ambos roles;
 * el alcance se filtra por rol en las queries, no se duplica la vista.
 */
model TrainingPlan {
  id               String             @id @default(cuid())
  title            String
  year             Int
  description      String?
  targetDepartment String? // mismo texto libre que User.department: sin modelo Department separado; null = todo el personal, cualquier área
  tutorId          String
  tutor            User               @relation("TrainingPlanTutor", fields: [tutorId], references: [id])
  status           TrainingPlanStatus @default(DRAFT)

  // Acta de cierre: cuándo, quién y con qué observaciones. Las observaciones
  // son obligatorias al cerrar -el cierre de un plan institucional no es un
  // clic, es una decisión con constancia-.
  closedAt          DateTime?
  closedBy          String?
  closedByUser      User?    @relation("TrainingPlanClosedBy", fields: [closedBy], references: [id])
  closeObservations String?

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  activities TrainingActivity[]
  documents  Media[]
  surveys    Survey[]

  @@index([tutorId])
  @@index([targetDepartment])
}

enum TrainingActivityType {
  COURSE // vinculada a un curso existente de la plataforma
  EXTERNAL_EVENT // evento externo presencial, sin curso asociado
}

/**
 * Ciclo de vida real de la jornada (Etapa 6): BORRADOR -> ABIERTA (visible
 * a estudiantes del área, admite respuestas) -> CERRADA (participación
 * congelada, indicadores consolidados). El campo se define ahora; el flujo
 * de habilitar/cerrar se construye en su propia etapa.
 */
enum TrainingActivityStatus {
  DRAFT
  OPEN
  CLOSED
}

/**
 * Área o proceso responsable dentro del PIC (Calidad, PAI, SST, Talento
 * Humano…). Tabla y no enum: las áreas del plan cambian de un año a otro y
 * Talento Humano tiene que poder agregar una sin migración.
 *
 * Es además el eje de agregación que pedían los indicadores ("adherencia por
 * área"): antes solo existía User.department, texto libre y vacío en todo el
 * personal importado.
 */
model TrainingArea {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int
  isActive  Boolean @default(true)

  /**
   * Quién responde por las capacitaciones del área.
   *
   * El plan nombra responsables por CARGO ("Profesional Lider PAI",
   * "Coordinacion SIAU"), no por persona. Esta relación es la que convierte
   * ese texto en alguien que de verdad puede entrar a la plataforma, subir
   * su presentación y cerrar sus jornadas.
   */
  tutorId String?
  tutor   User?   @relation("TrainingAreaTutor", fields: [tutorId], references: [id])

  activities TrainingActivity[]

  @@index([isActive])
  @@index([tutorId])
}

/** Cómo se dicta. MIXTA = el PIC la programa virtual en unos trimestres y presencial en otros. */
enum TrainingModality {
  VIRTUAL
  PRESENCIAL
  MIXTA
}

/** Franja de la jornada, tal como la nombra la institución. */
enum SessionShift {
  MANANA
  TARDE
}

model TrainingActivity {
  id             String                 @id @default(cuid())
  planId         String
  plan           TrainingPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  areaId         String?
  area           TrainingArea?          @relation(fields: [areaId], references: [id])
  title          String
  type           TrainingActivityType
  courseId       String? // opcional siempre: "No aplica" = gestión directa, sin curso vinculado
  course         Course?                @relation(fields: [courseId], references: [id])
  // El PIC programa por TRIMESTRE, no por fecha: la mayoría de actividades
  // nace sin día definido y solo lo adquiere cuando se agenda una jornada
  // concreta (TrainingSession). Por eso startDate es opcional.
  startDate      DateTime?
  endDate        DateTime?
  /** Trimestres marcados en el PIC. Una misma actividad puede repetirse en varios. */
  quarters       Int[]                  @default([])
  targetAudience CourseAudience         @default(AMBOS) // reutiliza el enum de Course, misma semántica
  isRequired     Boolean                @default(true)
  status         TrainingActivityStatus @default(DRAFT)
  enabledAt      DateTime? // Etapa 6: cuándo pasó a ABIERTA
  closedAt       DateTime? // Etapa 6: cuándo se cerró (participación congelada desde ese momento)
  /**
   * Override de excepción: el administrador retiró esta capacitación de la
   * vista aunque su ficha esté completa.
   *
   * La apertura dejó de ser un paso manual -una ficha completa se publica
   * sola-, así que hacía falta una forma explícita de decir "esta todavía
   * no". Es una marca aparte y no un estado, precisamente para que volver a
   * editar la ficha no deshaga la decisión sin que nadie se entere.
   */
  manuallyHidden Boolean   @default(false)

  /**
   * Las dos ventanas del ciclo presaber/postsaber, solo para capacitaciones
   * CON curso vinculado: es sobre la evaluación final de ESE curso que se
   * abren y se cierran. Cuatro marcas de tiempo en vez de un enum de estado
   * porque presaber y postsaber son independientes -"cerrado" no dice CUÁL
   * de los dos-, y porque conservar cuándo pasó cada cosa es justo lo que
   * "abierto/cerrado" por sí solo no guarda.
   *
   * Regla institucional: el postsaber no se habilita hasta que el presaber
   * esté cerrado -se presenta antes de la capacitación, no en paralelo-,
   * reforzada en el servidor, no solo aquí.
   */
  presaberOpenedAt   DateTime?
  presaberClosedAt   DateTime?
  postsaberOpenedAt  DateTime?
  postsaberClosedAt  DateTime?

  // ---- Columnas del PIC que antes no tenían dónde vivir ----
  /**
   * Programa dentro del área, cuando el plan lo especifica ("PAI", "Seguridad
   * del Paciente", "IAAS - PROA - PMMHM").
   *
   * El plan escribe "CALIDAD - SEGURIDAD DEL PACIENTE" en una sola celda,
   * pero eso no son dos áreas: es un área y uno de sus programas. Separarlos
   * es lo que permite que Calidad tenga UNA responsable y no una por cada
   * programa que maneja.
   */
  programa   String?
  objective  String? // "Objetivo" del Excel
  methodology String? // "Metodología": texto completo, incluida la distribución por trimestre
  // Obligatoria desde la Fase 10: toda actividad lleva su tag de modalidad
  // visible. MIXTA se conserva -38 de las 59 líneas reales del PIC lo son-.
  modality   TrainingModality @default(VIRTUAL)
  /**
   * "Dirigido A" en las palabras del PIC ("Vacunadores y auxiliares de
   * enfermería de APS"). Se conserva literal porque es mucho más específico
   * que targetAudience, que solo distingue asistencial/administrativo.
   */
  targetAudienceNote    String?
  /**
   * "N° de personas a capacitar". Casi siempre dice "DATO DE CADA IPS", o
   * sea que la cifra no existe todavía; por eso se guarda el texto tal cual
   * y el número solo cuando de verdad lo hay.
   */
  expectedAttendeesNote String?
  expectedAttendees     Int?
  /** "Responsable" del PIC: es un ROL ("Profesional Lider PAI"), no un usuario. */
  responsibleLabel  String?
  /** El usuario concreto, cuando se sepa quién es. Nunca se adivina desde el texto. */
  responsibleUserId String?
  responsibleUser   User?   @relation("TrainingActivityResponsible", fields: [responsibleUserId], references: [id])
  /** "Seguimiento": evidencias que el PIC exige para dar la actividad por cumplida. */
  followUpEvidence  String[] @default([])
  /** Fila del Excel de origen. Permite rastrear cada actividad hasta el PIC firmado. */
  sourceRow         Int?

  /**
   * Informe CONGELADO de la jornada, escrito una sola vez al cerrarla.
   *
   * Hasta ahora el informe se recalculaba en vivo sobre las tablas cada vez
   * que alguien lo abría. Eso significa que borrar un usuario, anular un
   * intento o corregir una clave de respuestas MESES DESPUÉS cambiaba
   * retroactivamente un informe que ya se había firmado y radicado. Un acta
   * no puede cambiar sola.
   *
   * Al cerrar se materializa aquí el informe completo -indicadores de
   * adherencia, personas, por pregunta, asistencia, encuestas y externos-, y
   * desde ese momento el PDF y la pantalla leen de aquí. Antes del cierre no
   * hay snapshot y todo se calcula en vivo, que es justo lo que se quiere
   * mientras las cifras aún se mueven.
   */
  reportSnapshot    Json?
  reportSnapshotAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents   Media[]
  attendances TrainingAttendance[]
  surveys     Survey[]
  sessions    TrainingSession[]
  externalParticipants ExternalParticipant[]
  callConnections      CallConnectionLog[]

  @@index([planId])
  @@index([courseId])
  @@index([areaId])
}

/**
 * Jornada concreta: el día, la hora y el lugar en que una actividad del PIC
 * se dicta de verdad.
 *
 * Existe separada de TrainingActivity porque son dos cosas distintas y el
 * Excel lo deja claro: la actividad es la LÍNEA DEL PLAN (un tema, un
 * objetivo, unos trimestres), y una misma línea se ejecuta varias veces —en
 * varias IPS y varios trimestres— cada una con su fecha, su franja y su
 * asistencia. Meter la fecha en la actividad obligaría a duplicar la línea
 * del plan una vez por ejecución y a perder el vínculo con el PIC.
 */
/**
 * FASE 10 — Sesión presencial con fases en vivo.
 *
 * La sesión ya existía (TrainingSession, con fecha, lugar, municipio y
 * cupo); lo que la Fase 10 agrega es la MÁQUINA DE FASES que el tutor
 * controla durante la jornada y el token del enlace público /s/[token]. Se
 * extiende el modelo real en vez de crear un "SesionPresencial" paralelo:
 * dos modelos de sesión conviviendo habría sido la fuente segura de
 * jornadas a medio camino entre uno y otro.
 */
enum FaseSesion {
  REGISTRO // se registra asistencia con el QR
  PRESABER
  CAPACITACION // en curso: pantalla informativa
  POSTSABER
  CERRADA
}

model TrainingSession {
  id         String           @id @default(cuid())
  activityId String
  activity   TrainingActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  startsAt DateTime
  endsAt   DateTime?
  shift    SessionShift?
  modality TrainingModality @default(VIRTUAL)
  /** Lugar físico o sala. Texto libre mientras no exista un catálogo de IPS/sedes. */
  location   String?
  meetingUrl String?
  capacity   Int?
  /** Nombre del ponente o facilitador, tal como se anuncia en el auditorio. */
  facilitador String?

  municipioId String?
  municipio   Municipio? @relation(fields: [municipioId], references: [id])

  status TrainingActivityStatus @default(DRAFT)

  /**
   * Fase EN VIVO de la sesión presencial, controlada solo por el tutor o el
   * administrador: el mismo QR cambia de comportamiento según la fase, así
   * que un solo cartel impreso sirve toda la jornada.
   */
  fase FaseSesion @default(REGISTRO)
  /** Identificador del enlace público /s/[token]: impredecible, va en el QR. */
  tokenPublico String @unique @default(cuid())
  /**
   * Totales congelados al CERRAR la sesión (asistentes, presaber, postsaber,
   * adherencia): el informe de una jornada que ya pasó no debe moverse
   * porque después se toquen registros. Mismo principio del acta congelada
   * de la actividad.
   */
  cierreSnapshot Json?
  cerradaEl      DateTime?

  asistencias AsistenciaSesion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activityId])
  @@index([startsAt])
}

/**
 * Asistencia a UNA sesión presencial concreta (a diferencia de
 * TrainingAttendance, que es por actividad y sigue intacta para lo
 * virtual). Resuelve la limitación conocida de "asistencia solo con curso":
 * una sesión presencial registra asistencia aunque la actividad no tenga
 * curso enganchado.
 */
model AsistenciaSesion {
  id       String          @id @default(cuid())
  sesionId String
  sesion   TrainingSession @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  userId   String
  user     User            @relation("AsistenciaSesionUser", fields: [userId], references: [id], onDelete: Cascade)

  registradaEn DateTime @default(now())
  /** "QR" cuando la persona escaneó; "MANUAL" cuando la registró el tutor. */
  medio String @default("QR")

  // Doble escaneo no duplica: la restricción es la idempotencia.
  @@unique([sesionId, userId])
  @@index([sesionId])
}

/**
 * PARTICIPANTE EXTERNO de una jornada: gente que no pertenece a la entidad
 * (otras IPS, contratistas de terceros) y que por decisión institucional NO
 * recibe cuenta en la plataforma. Se registra con lo mínimo -nombre y
 * empresa- desde el enlace público /invitado/{actividad}, y solo puede ver
 * la sala de la jornada y presentar el presaber/postsaber. El registro
 * mismo ES su constancia de asistencia externa.
 */
model ExternalParticipant {
  id         String           @id @default(cuid())
  activityId String
  activity   TrainingActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  fullName   String
  company    String
  createdAt  DateTime         @default(now())

  attempts ExternalAttempt[]
  callConnections CallConnectionLog[]

  @@index([activityId])
}

/**
 * Intento de un externo sobre la evaluación del ciclo. UNO por momento y
 * por participante: sin cuenta no hay historial que administrar, y un solo
 * intento mantiene el dato limpio para el informe. Se guarda la selección
 * (answers) como evidencia auditable de la calificación automática.
 */
model ExternalAttempt {
  id            String              @id @default(cuid())
  participantId String
  participant   ExternalParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  moment        EvaluationMoment
  score         Int
  passed        Boolean
  answers       Json?
  createdAt     DateTime            @default(now())

  @@unique([participantId, moment])
  @@index([participantId])
}

/**
 * Etapa 3: solo existe cuando la actividad NO tiene curso vinculado (evento
 * externo, o "No aplica" con gestión directa) — sin curso no hay señal de
 * completitud automática, así que la asistencia se registra manualmente.
 * Las actividades con curso vinculado calculan adherencia en vivo desde
 * Enrollment, sin necesidad de esta tabla.
 */
/** Quién registró la asistencia: una persona a mano, o el sistema al entrar a la evaluación. */
enum AttendanceSource {
  MANUAL
  AUTOMATIC
}

model TrainingAttendance {
  id           String           @id @default(cuid())
  activityId   String
  activity     TrainingActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation("TrainingAttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  attended     Boolean          @default(false)
  registeredAt DateTime         @default(now())
  // Nula cuando el registro lo hizo el sistema: la asistencia automática no
  // la marca ninguna persona, y forzar aquí un usuario habría significado
  // inventar quién "la registró" cuando en realidad fue el propio estudiante
  // al entrar a su evaluación.
  registeredBy String?
  registeredByUser User?        @relation("TrainingAttendanceRegisteredBy", fields: [registeredBy], references: [id])
  source       AttendanceSource @default(MANUAL)

  @@unique([activityId, userId])
  @@index([activityId])
}

/**
 * Un TRAMO de conexión a la videollamada de una jornada: se cierra y se
 * escribe UNA sola vez, cuando la persona sale de la sala (o cierra la
 * pestaña) -nunca mientras está conectada-. Quien entra y sale varias veces
 * en la misma jornada deja varios tramos; el minutaje por persona se suma al
 * leer, no al escribir, así que este modelo es puramente de anexar (append
 * only) y no compite con nada más por escritura.
 *
 * No es la fuente de la asistencia (eso lo sigue siendo TrainingAttendance,
 * que no se toca): es trazabilidad interna de tiempo conectado, para que
 * Talento Humano pueda auditar cuánto estuvo realmente cada quien en la
 * llamada, por plan de capacitación.
 */
model CallConnectionLog {
  id         String           @id @default(cuid())
  activityId String
  activity   TrainingActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  // Uno de los dos, nunca los dos ni ninguno: personal con cuenta, o
  // invitado externo sin ella. Igual que ExternalParticipant frente a User
  // en el resto del módulo.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalParticipantId String?
  externalParticipant   ExternalParticipant? @relation(fields: [externalParticipantId], references: [id], onDelete: Cascade)

  // Nombre en el momento de la llamada: si es invitado, o si a alguien le
  // cambian el nombre después, el registro sigue siendo legible sin tener
  // que reconstruirlo por join.
  displayName     String
  joinedAt        DateTime
  leftAt          DateTime
  durationSeconds Int
  createdAt       DateTime @default(now())

  @@index([activityId])
  @@index([userId])
}

// ------------------------------------------------------------------
// MÓDULO DE ENCUESTAS
//
// Sustituye al modelo plano de la Etapa 4 (cuatro tipos de pregunta, sin
// páginas y solo para gente con sesión). Aquel nunca llegó a usarse -cero
// filas- y se quedaba corto para lo que la entidad necesita: encuestas de
// satisfacción abiertas a la comunidad, evaluaciones de conocimiento con
// clave de respuesta, y material de apoyo embebido dentro del formulario.
//
// Tres decisiones de fondo:
//
//  1. PÁGINAS (bloques). Una encuesta se recorre por pasos, no como una
//     lista interminable: cada bloque agrupa sus preguntas y puede llevar
//     su propio material (las diapositivas de la guía que se está
//     evaluando). Es también la unidad de puntaje: "Manejo de IVU: 68/80".
//
//  2. CONFIGURACIÓN EN JSON por pregunta, en vez de una columna por
//     variante. Las opciones, la escala, la clave de respuesta y los puntos
//     viven en `config`; así un tipo nuevo no obliga a migrar la tabla, que
//     es justo lo que dejó clavado al modelo anterior en cuatro tipos.
//
//  3. ENLACE PÚBLICO con `slug`. Una encuesta de satisfacción dirigida a la
//     comunidad no puede exigir cuenta institucional. `requireLogin`
//     decide caso por caso, y la respuesta queda igual de almacenada.
// ------------------------------------------------------------------

enum SurveyStatus {
  DRAFT // se está construyendo: no admite respuestas
  PUBLISHED // enlace vivo
  CLOSED // ya no recibe respuestas; los resultados quedan para consulta
}

/** A quién va dirigida: define si el enlace público tiene sentido y con qué alcance. */
enum SurveyAudience {
  INTERNO // personal de la entidad
  EXTERNO // comunidad, usuarios, proveedores
  MIXTA
}

enum SurveyQuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  YES_NO
  SCALE // Likert; el rango va en config
  NUMBER
  DATE
  IMAGE_CHOICE // opciones con imagen
  MATCHING // relacionar elementos con grupos
}

model Survey {
  id   String @id @default(cuid())
  /** Consecutivo legible para citarla en actas: ENC-2026-0001. */
  code String @unique
  /** Identificador del enlace público. Corto e impredecible: va en un QR. */
  slug String @unique

  title       String
  description String?
  /** Portada del formulario público. */
  coverImageUrl String?
  /** Acento del formulario público, para que cada encuesta tenga identidad propia. */
  themeColor    String?
  /** Minutos aproximados, para anunciarlos antes de empezar. */
  estimatedMinutes Int?

  audience   SurveyAudience @default(INTERNO)
  status     SurveyStatus   @default(DRAFT)
  /** Plantilla reutilizable: no se responde, se duplica. */
  isTemplate Boolean        @default(false)
  /**
   * Encuesta de satisfacción FIJA: el modelo institucional que se clona y
   * publica automáticamente para cada capacitación al cerrar su jornada.
   * Solo debería haber una con la marca; se sobreescribe cuando Talento
   * Humano entregue el modelo definitivo.
   */
  esSatisfaccionFija Boolean @default(false)

  // ---- Modularización por capacitación -------------------------------
  // Una encuesta puede colgar de un plan, de una jornada concreta, o de
  // ninguno de los dos (encuesta institucional suelta). Es lo que permite
  // medir satisfacción y adherencia POR capacitación sin mezclarlas.
  trainingPlanId     String?
  trainingPlan       TrainingPlan?     @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  trainingActivityId String?
  trainingActivity   TrainingActivity? @relation(fields: [trainingActivityId], references: [id], onDelete: Cascade)

  // ---- Alcance dentro del personal (solo aplica a las internas) -------
  targetDepartment String?
  targetAudience   CourseAudience @default(AMBOS)

  /** Exigir sesión aunque el enlace sea público (encuestas nominales). */
  requireLogin           Boolean @default(false)
  /** Permitir responder varias veces desde el mismo enlace. */
  allowMultipleResponses Boolean @default(false)
  /** Mostrar el puntaje al terminar (evaluaciones de conocimiento). */
  showScoreToRespondent  Boolean @default(false)
  thankYouMessage        String?

  opensAt     DateTime?
  closesAt    DateTime?
  publishedAt DateTime?
  closedAt    DateTime?

  createdBy String
  creator   User     @relation("SurveyCreatedBy", fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages     SurveyPage[]
  responses SurveyResponse[]

  @@index([trainingPlanId])
  @@index([trainingActivityId])
  @@index([status])
}

/** Un bloque del recorrido: "Paso 2 de 5". Unidad de agrupación y de puntaje. */
model SurveyPage {
  id       String @id @default(cuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  sortOrder   Int
  title       String
  description String?
  /**
   * Material de apoyo del bloque: la presentación o la guía que se está
   * evaluando, embebida DENTRO del formulario. Sin esto, quien responde
   * tiene que buscar el documento por fuera y la mitad no lo hace.
   */
  attachmentUrl  String?
  attachmentName String?

  questions SurveyQuestion[]

  @@unique([surveyId, sortOrder])
}

model SurveyQuestion {
  id     String @id @default(cuid())
  pageId String
  page   SurveyPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  sortOrder   Int
  type        SurveyQuestionType
  prompt      String
  description String?
  imageUrl    String?
  isRequired  Boolean            @default(true)

  /**
   * Todo lo que depende del tipo: `options` (con su id y texto), `scaleMin`
   * y `scaleMax`, `correctOptionId` y `points` cuando la pregunta califica,
   * los grupos de una de relacionar.
   *
   * Una pregunta entra al puntaje SOLO si trae `correctOptionId`. Nunca se
   * asume una respuesta correcta por defecto: una pregunta sin clave se
   * queda fuera del cálculo en vez de adivinarla.
   */
  config Json?

  answers SurveyAnswer[]

  @@unique([pageId, sortOrder])
}

model SurveyResponse {
  id       String @id @default(cuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  /** Null cuando se respondió por el enlace público sin sesión. */
  userId String?
  user   User?   @relation("SurveyRespondedBy", fields: [userId], references: [id], onDelete: SetNull)
  /** Nombre declarado por quien responde sin cuenta. */
  respondentName String?

  /**
   * Una respuesta empieza al abrir el formulario y se marca completa al
   * enviarla. Guardar las incompletas es deliberado: la tasa de abandono
   * -cuánta gente empieza y no termina- dice tanto como el resultado.
   */
  completed   Boolean   @default(false)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  /** Puntaje congelado al enviar, cuando la encuesta tiene clave de respuesta. */
  scorePercent  Int?
  scoreEarned   Int?
  scorePossible Int?

  /** "publico" | "plataforma": por dónde entró. */
  channel String?

  answers SurveyAnswer[]

  @@index([surveyId])
  @@index([userId])
}

model SurveyAnswer {
  id         String         @id @default(cuid())
  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /** Valor tipado según la pregunta: ids elegidos, número, fecha, pares de relación. */
  value     Json?
  /** Texto libre, aparte del JSON, para poder buscarlo y exportarlo directo. */
  textValue String?

  @@unique([responseId, questionId])
}


// ------------------------------------------------------------------
// Recuperación de contraseña por código enviado al correo
// ------------------------------------------------------------------

/**
 * Código de un solo uso para restablecer la contraseña.
 *
 * Se guarda el HASH del código, nunca el código en claro: quien tenga acceso
 * a la base no debe poder tomar cuentas ajenas. Lleva contador de intentos
 * para frenar la adivinación por fuerza bruta de un código de 6 dígitos.
 */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
